# Copy to .env, then fill in. The framework refuses to start if a required value is missing.
# These are public demo credentials, not real accounts.

APP_ENV=local
WEB_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://restful-booker.herokuapp.com

SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

API_USERNAME=admin
API_PASSWORD=password123

# Optional overrides (milliseconds)
# TEST_TIMEOUT_MS=30000
# EXPECT_TIMEOUT_MS=5000
# ACTION_TIMEOUT_MS=10000
# NAVIGATION_TIMEOUT_MS=15000
