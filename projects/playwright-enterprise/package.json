{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-convention Playwright + TypeScript framework: auth state, typed fixtures, API layer, sharded CI, trace-based debugging",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --project=ui --grep @smoke",
    "test:regression": "playwright test --project=ui --grep @regression",
    "test:shard": "playwright test --project=ui --shard=1/2",
    "test:ui-mode": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "auth": "playwright test --project=setup",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.20.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0"
  }
}
